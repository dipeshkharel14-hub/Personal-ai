<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="theme-color" content="#000810"/>
<title>J.A.R.V.I.S. — Dipesh Kharel</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet"/>
<!-- MediaPipe Hands & Camera Utils for High-Precision Joint Tracking -->
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
<style>
/* ══════════════ ROOT ══════════════ */
:root{
  --arc:#00cfff;--arc2:#0af7ff;--arc-dim:#005f7f;
  --red:#ff3434;--red2:#ff6060;--gold:#ffc140;--green:#00ff88;
  --bg:#000810;--bg2:#000d1a;
  --glass:rgba(0,20,40,.72);--glass2:rgba(0,10,25,.88);
  --border:rgba(0,207,255,.18);--border2:rgba(255,52,52,.22);
  --text:#cce8ff;--text2:#4a8aaa;
  --glow:rgba(0,207,255,.4);--rglow:rgba(255,52,52,.4);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{width:100%;min-height:100vh;overflow-x:hidden;background:var(--bg);}
body{font-family:'Share Tech Mono',monospace;color:var(--text);cursor:crosshair;
  background:radial-gradient(ellipse at 50% 0%,rgba(0,60,100,.35) 0%,var(--bg) 65%);}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:linear-gradient(rgba(0,207,255,.022) 1px,transparent 1px),
             linear-gradient(90deg,rgba(0,207,255,.022) 1px,transparent 1px);
  background-size:48px 48px;animation:gridB 8s ease-in-out infinite;}
@keyframes gridB{0%,100%{opacity:.5}50%{opacity:1}}
.scanline{position:fixed;top:0;left:0;width:100%;height:3px;pointer-events:none;z-index:998;
  background:linear-gradient(90deg,transparent,var(--arc),transparent);
  box-shadow:0 0 18px var(--arc);animation:scan 6s linear infinite;}
@keyframes scan{from{top:-4px}to{top:100vh}}

/* ══════════════ INTRO ══════════════ */
#intro{position:fixed;inset:0;z-index:10000;background:#000;
  display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}
#intro.fade{animation:introFade .9s ease forwards;}
@keyframes introFade{to{opacity:0;pointer-events:none;visibility:hidden;}}
.ic{position:absolute;width:44px;height:44px;}
.ic.tl{top:18px;left:18px;border-top:2px solid var(--arc);border-left:2px solid var(--arc);}
.ic.tr{top:18px;right:18px;border-top:2px solid var(--arc);border-right:2px solid var(--arc);}
.ic.bl{bottom:18px;left:18px;border-bottom:2px solid var(--arc);border-left:2px solid var(--arc);}
.ic.br{bottom:18px;right:18px;border-bottom:2px solid var(--arc);border-right:2px solid var(--arc);}
.il{position:absolute;}
.il.h{top:50%;left:0;width:0;height:1px;background:linear-gradient(90deg,transparent,var(--arc),transparent);box-shadow:0 0 12px var(--arc);animation:ilh 2.5s ease forwards;}
.il.v{left:50%;top:0;width:1px;height:0;background:linear-gradient(180deg,transparent,var(--arc),transparent);animation:ilv 2.5s ease forwards;}
@keyframes ilh{0%{width:0;left:50%}100%{width:100%;left:0}}
@keyframes ilv{0%{height:0;top:50%}100%{height:100%;top:0}}
.intro-wrap{position:relative;z-index:2;text-align:center;}
.i-pre{font-family:'Rajdhani',sans-serif;font-size:clamp(.65rem,2vw,.9rem);letter-spacing:.6em;
  color:var(--text2);text-transform:uppercase;opacity:0;animation:fu .6s ease .5s forwards;}
.i-name{font-family:'Orbitron',sans-serif;font-weight:900;font-size:clamp(2rem,7vw,5rem);
  letter-spacing:.1em;background:linear-gradient(135deg,var(--arc),var(--arc2),var(--gold),var(--arc));
  background-size:300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 35px var(--glow));opacity:0;
  animation:fu .7s ease .9s forwards,shim 4s linear 1.2s infinite;}
.i-role{font-family:'Rajdhani',sans-serif;font-size:clamp(.6rem,1.8vw,.85rem);letter-spacing:.45em;
  color:var(--arc-dim);text-transform:uppercase;margin-top:7px;opacity:0;animation:fu .6s ease 1.3s forwards;}
.i-div{width:0;height:1px;background:linear-gradient(90deg,transparent,var(--arc),transparent);
  margin:18px auto;box-shadow:0 0 10px var(--arc);animation:idiv .8s ease 1.6s forwards;}
@keyframes idiv{to{width:min(380px,68vw)}}
.i-tag{font-family:'Orbitron',sans-serif;font-size:clamp(1.1rem,4.5vw,2rem);
  letter-spacing:.28em;color:#fff;text-shadow:0 0 30px var(--arc),0 0 60px var(--glow);
  opacity:0;animation:fu .7s ease 1.9s forwards;}
.i-sub{font-size:.55rem;letter-spacing:.3em;color:var(--text2);margin-top:8px;
  opacity:0;animation:fu .6s ease 2.2s forwards;}
@keyframes fu{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes shim{to{background-position:300%}}
/* ══════════════ BOOT ══════════════ */
#boot{position:fixed;inset:0;z-index:9000;background:var(--bg);
  flex-direction:column;align-items:center;justify-content:center;
  gap:14px;transition:opacity .8s;display:none;}
#boot.active{display:flex;}
#boot.hide{opacity:0;pointer-events:none;}
.b-logo{font-family:'Orbitron',sans-serif;font-weight:900;font-size:clamp(1.8rem,6vw,3.5rem);
  letter-spacing:.4em;background:linear-gradient(90deg,var(--arc),var(--gold),var(--arc));
  background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  animation:shim 3s linear infinite;filter:drop-shadow(0 0 20px var(--glow));}
.b-owner{font-family:'Orbitron',sans-serif;font-size:.7rem;color:var(--gold);
  letter-spacing:.35em;text-shadow:0 0 14px var(--gold);}
.b-bar{width:min(340px,78vw);height:3px;background:rgba(0,207,255,.1);border-radius:2px;overflow:hidden;}
.b-fill{height:100%;width:0;background:linear-gradient(90deg,var(--arc-dim),var(--arc));
  box-shadow:0 0 14px var(--arc);transition:width .28s ease;}
.b-status{font-size:.58rem;letter-spacing:.15em;color:var(--text2);text-align:center;}
.b-lines{font-size:.55rem;color:var(--arc-dim);text-align:left;line-height:2.1;width:min(340px,78vw);}
.bli{opacity:0;transform:translateX(-8px);transition:all .3s;}
.bli.on{opacity:1;transform:none;}

/* ══════════════ WAKE BANNER ══════════════ */
#wake{position:fixed;top:0;left:0;right:0;z-index:9500;
  background:linear-gradient(135deg,rgba(0,207,255,.1),rgba(0,50,90,.92));
  border-bottom:2px solid var(--arc);padding:16px;backdrop-filter:blur(20px);
  text-align:center;pointer-events:none;
  transform:translateY(-100%);transition:transform .35s cubic-bezier(.34,1.56,.64,1);}
#wake.show{transform:translateY(0);}
.wake-t{font-family:'Orbitron',sans-serif;font-size:clamp(.85rem,3vw,1.2rem);
  color:var(--arc);letter-spacing:.2em;text-shadow:0 0 20px var(--arc);
  animation:wp .9s ease-in-out infinite;}
@keyframes wp{0%,100%{opacity:.7}50%{opacity:1}}

/* ══════════════ HEADER ══════════════ */
header{position:sticky;top:0;z-index:400;display:flex;align-items:center;
  justify-content:space-between;flex-wrap:wrap;gap:8px;padding:10px 18px;
  background:rgba(0,5,15,.96);border-bottom:1px solid var(--border);backdrop-filter:blur(16px);}
.hl{font-family:'Orbitron',sans-serif;font-weight:900;font-size:clamp(.9rem,3vw,1.3rem);
  letter-spacing:.3em;background:linear-gradient(90deg,var(--arc),var(--gold));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 10px var(--glow));}
.ho{font-size:.5rem;letter-spacing:.18em;color:var(--gold);font-family:'Orbitron',sans-serif;margin-top:2px;}
.hclk{font-family:'Orbitron',sans-serif;font-size:clamp(.85rem,3vw,1.05rem);
  color:var(--arc);letter-spacing:.1em;text-shadow:0 0 10px var(--glow);text-align:center;}
.hdt{font-size:.48rem;color:var(--text2);letter-spacing:.1em;text-align:center;margin-top:1px;}
.hstat{font-size:.48rem;letter-spacing:.12em;text-align:right;}
.hstat span{display:block;margin-bottom:2px;}
.sd{display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:5px;}
.sd.g{background:var(--green);box-shadow:0 0 6px var(--green);animation:blink 2s infinite;}
.sd.r{background:var(--red);box-shadow:0 0 6px var(--red);}
.sd.y{background:var(--gold);box-shadow:0 0 6px var(--gold);animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.arc-hdr{width:48px;height:48px;position:relative;cursor:pointer;flex-shrink:0;}
.ar{position:absolute;border-radius:50%;border:1.5px solid;top:50%;left:50%;transform:translate(-50%,-50%);}
.ar1{width:48px;height:48px;border-color:var(--arc);animation:spin 8s linear infinite;}
.ar2{width:33px;height:33px;border-color:var(--arc-dim);border-style:dashed;animation:spin 5s linear infinite reverse;}
.ar3{width:21px;height:21px;border-color:rgba(0,207,255,.6);}
.arc-c{position:absolute;width:12px;height:12px;border-radius:50%;
  background:radial-gradient(circle,#fff 20%,var(--arc) 70%);top:50%;left:50%;transform:translate(-50%,-50%);
  box-shadow:0 0 14px var(--arc),0 0 30px var(--glow);animation:cp 2.4s ease-in-out infinite;}
@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
@keyframes cp{0%,100%{box-shadow:0 0 12px var(--arc),0 0 25px var(--glow)}50%{box-shadow:0 0 25px var(--arc),0 0 55px var(--glow)}}

/* ══════════════ LAYOUT ══════════════ */
.main{position:relative;z-index:5;padding:12px;
  display:grid;gap:12px;max-width:1300px;margin:0 auto;grid-template-columns:1fr;
  grid-template-areas:"center" "btm";}
@media(min-width:768px){
  .main{grid-template-columns:230px 1fr 210px;
        grid-template-areas:"left center right" "left btm right";}}
@media(min-width:1100px){.main{grid-template-columns:255px 1fr 250px;}}

/* ══════════════ PANEL ══════════════ */
.panel{background:var(--glass);border:1px solid var(--border);border-radius:4px;
  padding:14px;position:relative;backdrop-filter:blur(12px);
  box-shadow:0 0 25px rgba(0,207,255,.04),inset 0 1px 0 rgba(0,207,255,.07);}
.panel::before{content:'';position:absolute;top:0;left:18px;right:18px;height:1px;
  background:linear-gradient(90deg,transparent,var(--arc),transparent);}
.panel.rp{border-color:var(--border2);}
.panel.rp::before{background:linear-gradient(90deg,transparent,var(--red),transparent);}
.cd{position:absolute;width:13px;height:13px;}
.cd.tl{top:-1px;left:-1px;border-top:2px solid var(--arc);border-left:2px solid var(--arc);border-radius:3px 0 0 0;}
.cd.tr{top:-1px;right:-1px;border-top:2px solid var(--arc);border-right:2px solid var(--arc);border-radius:0 3px 0 0;}
.cd.bl{bottom:-1px;left:-1px;border-bottom:2px solid var(--arc);border-left:2px solid var(--arc);border-radius:0 0 0 3px;}
.cd.br{bottom:-1px;right:-1px;border-bottom:2px solid var(--arc);border-right:2px solid var(--arc);border-radius:0 0 3px 0;}
.panel.rp .cd{border-color:var(--red)!important;}
.ptitle{font-family:'Orbitron',sans-serif;font-size:.46rem;letter-spacing:.28em;color:var(--text2);
  text-transform:uppercase;padding-bottom:9px;margin-bottom:11px;
  border-bottom:1px solid rgba(0,207,255,.07);display:flex;align-items:center;gap:8px;}
.ptitle::before{content:'';display:inline-block;width:8px;height:1px;background:var(--arc);}

/* ══════════════ LEFT COL ══════════════ */
.col-left{grid-area:left;display:none;flex-direction:column;gap:12px;}
@media(min-width:768px){.col-left{display:flex;}}
.radar-box{width:100%;aspect-ratio:1;max-height:185px;background:rgba(0,8,18,.8);
  border:1px solid var(--border);border-radius:3px;overflow:hidden;}
.radar-box canvas{width:100%;height:100%;}
.metric{margin-bottom:11px;}
.mrow{display:flex;justify-content:space-between;margin-bottom:4px;font-size:.53rem;}
.mv{color:var(--arc);}
.mbar{height:3px;background:rgba(0,207,255,.07);border-radius:2px;overflow:hidden;}
.mfill{height:100%;border-radius:2px;transition:width 1.5s cubic-bezier(.4,0,.2,1);}
.mf-b{background:linear-gradient(90deg,var(--arc-dim),var(--arc));box-shadow:0 0 7px var(--arc);}
.mf-r{background:linear-gradient(90deg,#8b0000,var(--red));box-shadow:0 0 7px var(--red);}
.mf-g{background:linear-gradient(90deg,#004422,var(--green));box-shadow:0 0 7px var(--green);}
.mf-y{background:linear-gradient(90deg,#7a5c00,var(--gold));box-shadow:0 0 7px var(--gold);}
.bat-w{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.bat-i{width:34px;height:17px;border:1.5px solid var(--arc);border-radius:2px;padding:2px;position:relative;}
.bat-i::after{content:'';position:absolute;right:-5px;top:50%;transform:translateY(-50%);
  width:4px;height:7px;background:var(--arc);border-radius:0 1px 1px 0;}
.bat-l{height:100%;border-radius:1px;transition:width .8s;}
.bat-p{font-size:.63rem;color:var(--green);}
.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;}
.app-btn{background:rgba(0,207,255,.04);border:1px solid rgba(0,207,255,.11);
  color:var(--text2);font-family:'Share Tech Mono',monospace;font-size:.55rem;
  padding:7px 4px;cursor:pointer;border-radius:3px;transition:all .2s;text-align:center;line-height:1.6;}
.app-btn:hover,.app-btn:active{background:rgba(0,207,255,.13);color:var(--arc);
  border-color:var(--arc);box-shadow:0 0 12px rgba(0,207,255,.2);}
.app-btn .ai{font-size:1.05rem;display:block;}
.tl-item{font-size:.52rem;padding:5px 0 5px 13px;border-left:1px solid rgba(0,207,255,.18);
  color:var(--text2);position:relative;line-height:1.6;}
.tl-item::before{content:'';position:absolute;left:-3.5px;top:8px;
  width:5px;height:5px;border-radius:50%;background:var(--arc-dim);}
.tl-item.nw::before{background:var(--arc);box-shadow:0 0 6px var(--arc);}

/* ══════════════ CENTER COL ══════════════ */
.col-center{grid-area:center;display:flex;flex-direction:column;gap:12px;}
.arc-hero{position:relative;height:clamp(155px,28vw,230px);
  display:flex;align-items:center;justify-content:center;overflow:hidden;}
.arc-hero canvas{position:absolute;inset:0;width:100%;height:100%;}
.arc-hero-txt{position:relative;z-index:2;text-align:center;pointer-events:none;}
.ahmode{font-family:'Orbitron',sans-serif;font-weight:700;
  font-size:clamp(.7rem,2.2vw,.95rem);letter-spacing:.25em;color:var(--arc);text-shadow:0 0 18px var(--arc);}
.ahsub{font-family:'Rajdhani',sans-serif;font-size:clamp(.8rem,2.5vw,1.1rem);
  color:var(--text);margin-top:4px;letter-spacing:.07em;}
.ahowner{font-size:.42rem;letter-spacing:.2em;color:var(--text2);margin-top:3px;}
/* reactor */
.reactor{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:clamp(85px,13vw,120px);height:clamp(85px,13vw,120px);}
.rr{position:absolute;border-radius:50%;border:1.5px solid;top:50%;left:50%;transform:translate(-50%,-50%);}
.rr1{width:100%;height:100%;border-color:rgba(0,207,255,.55);animation:spin 12s linear infinite;}
.rr2{width:80%;height:80%;border-color:rgba(0,207,255,.3);border-style:dashed;animation:spin 7s linear infinite reverse;}
.rr3{width:60%;height:60%;border-color:rgba(0,207,255,.45);animation:spin 5s linear infinite;}
.rr4{width:40%;height:40%;border-color:rgba(255,52,52,.4);}
.rc{position:absolute;width:25%;height:25%;border-radius:50%;
  background:radial-gradient(circle,#fff 5%,var(--arc2) 40%,var(--arc) 75%);
  top:50%;left:50%;transform:translate(-50%,-50%);
  box-shadow:0 0 18px var(--arc),0 0 40px var(--glow),0 0 75px rgba(0,207,255,.13);
  animation:cp 2s ease-in-out infinite;}
/* viz */
.vviz{height:48px;display:flex;align-items:center;justify-content:center;gap:3px;padding:0 10px;}
.vb{width:3px;min-height:3px;border-radius:2px;background:var(--arc);box-shadow:0 0 4px var(--glow);transition:height .07s ease;}
/* status ring */
.sring{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:0 14px 13px;}
.sri{background:rgba(0,207,255,.04);border:1px solid rgba(0,207,255,.1);border-radius:3px;padding:7px 4px;text-align:center;}
.srl{font-size:.42rem;letter-spacing:.12em;color:var(--text2);margin-bottom:3px;}
.srv{font-family:'Orbitron',sans-serif;font-size:clamp(.65rem,1.8vw,.8rem);font-weight:700;
  color:var(--arc);text-shadow:0 0 8px var(--glow);}
/* chat */
#chat{min-height:220px;max-height:340px;overflow-y:auto;padding:12px;
  display:flex;flex-direction:column;gap:9px;
  scrollbar-width:thin;scrollbar-color:var(--arc-dim) transparent;}
#chat::-webkit-scrollbar{width:3px;}
#chat::-webkit-scrollbar-thumb{background:var(--arc-dim);border-radius:2px;}
.msg{max-width:91%;padding:10px 13px;border-radius:3px;font-size:.73rem;line-height:1.7;
  animation:mi .27s ease;font-family:'Rajdhani',sans-serif;letter-spacing:.02em;}
@keyframes mi{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg-u{align-self:flex-end;background:rgba(0,207,255,.07);
  border:1px solid rgba(0,207,255,.22);border-right:3px solid var(--arc);}
.msg-j{align-self:flex-start;background:rgba(0,28,52,.75);
  border:1px solid rgba(0,207,255,.13);border-left:3px solid var(--gold);}
.msg-s{align-self:center;background:rgba(255,52,52,.05);
  border:1px solid rgba(255,52,52,.15);color:var(--red2);
  font-size:.58rem;letter-spacing:.1em;text-align:center;padding:6px 13px;}
.mlbl{font-size:.44rem;letter-spacing:.18em;font-family:'Orbitron',monospace;margin-bottom:4px;}
.msg-u .mlbl{color:var(--arc-dim);text-align:right;}
.msg-j .mlbl{color:var(--gold);}
.msg-s .mlbl{color:var(--red);}
.typi{display:none;align-self:flex-start;padding:10px 13px;
  background:rgba(0,28,52,.75);border:1px solid rgba(0,207,255,.13);
  border-left:3px solid var(--gold);border-radius:3px;}
.typi.on{display:flex;align-items:center;gap:4px;}
.td{width:6px;height:6px;border-radius:50%;background:var(--arc);animation:tdot 1.1s ease-in-out infinite;}
.td:nth-child(2){animation-delay:.18s}.td:nth-child(3){animation-delay:.36s}
@keyframes tdot{0%,80%,100%{opacity:.25;transform:scale(.7)}40%{opacity:1;transform:scale(1)}}
.cursor{display:inline-block;width:2px;height:.9em;background:var(--gold);
  margin-left:2px;animation:cb .7s ease-in-out infinite;vertical-align:middle;}
@keyframes cb{0%,100%{opacity:1}50%{opacity:0}}
/* input bar */
.inp-bar{display:flex;gap:7px;align-items:center;padding:9px 13px;
  background:rgba(0,5,15,.9);border:1px solid var(--border);border-radius:4px;}
#inp{flex:1;background:transparent;border:none;outline:none;color:var(--text);
  font-family:'Rajdhani',sans-serif;font-size:.86rem;caret-color:var(--arc);}
#inp::placeholder{color:var(--text2);}
/* cmd grid */
.cmd-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;}
@media(min-width:500px){.cmd-grid{grid-template-columns:repeat(6,1fr);}}
@media(min-width:768px){.cmd-grid{grid-template-columns:repeat(4,1fr);}}
@media(min-width:1100px){.cmd-grid{grid-template-columns:repeat(6,1fr);}}
.cmd-btn{background:rgba(0,207,255,.04);border:1px solid rgba(0,207,255,.1);
  color:var(--text2);padding:8px 4px;cursor:pointer;border-radius:3px;
  font-size:.52rem;text-align:center;line-height:1.7;transition:all .2s;
  font-family:'Share Tech Mono',monospace;}
.cmd-btn:hover,.cmd-btn:active{background:rgba(0,207,255,.13);color:var(--arc);
  border-color:var(--arc);box-shadow:0 0 12px rgba(0,207,255,.2);}
.cmd-btn .ci{font-size:1.1rem;display:block;}

/* ══════════════ RIGHT COL ══════════════ */
.col-right{grid-area:right;display:none;flex-direction:column;gap:12px;}
@media(min-width:768px){.col-right{display:flex;}}
.cam-wrap{width:100%;aspect-ratio:4/3;background:#000;border:1px solid var(--border);
  border-radius:3px;overflow:hidden;position:relative;}
#cam-vid{width:100%;height:100%;object-fit:cover;opacity:.85;transform:scaleX(-1);display:block;}
#hand-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;transform:scaleX(-1);}
.cam-ov{position:absolute;inset:0;pointer-events:none;border:1px solid rgba(0,207,255,.14);}
.cam-sc{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--arc),transparent);animation:cs 4s linear infinite;}
@keyframes cs{from{top:0}to{top:100%}}
.cam-co{position:absolute;width:14px;height:14px;}
.cam-co.tl{top:5px;left:5px;border-top:2px solid var(--arc);border-left:2px solid var(--arc);}
.cam-co.tr{top:5px;right:5px;border-top:2px solid var(--arc);border-right:2px solid var(--arc);}
.cam-co.bl{bottom:5px;left:5px;border-bottom:2px solid var(--arc);border-left:2px solid var(--arc);}
.cam-co.br{bottom:5px;right:5px;border-bottom:2px solid var(--arc);border-right:2px solid var(--arc);}
.cam-st{position:absolute;top:7px;left:50%;transform:translateX(-50%);
  font-size:.44rem;letter-spacing:.2em;color:var(--arc);}
.cam-cd{position:absolute;bottom:7px;left:50%;transform:translateX(-50%);
  font-size:.4rem;letter-spacing:.1em;color:var(--arc-dim);white-space:nowrap;}
.w-ico{font-size:2.6rem;line-height:1;margin-bottom:4px;text-align:center;}
.w-temp{font-family:'Orbitron',sans-serif;font-size:1.7rem;font-weight:700;
  color:var(--arc);text-shadow:0 0 14px var(--glow);text-align:center;}
.w-lbl{font-size:.5rem;letter-spacing:.14em;color:var(--text2);margin-top:3px;text-align:center;}
.w-g{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:9px;}
.wi{background:rgba(0,207,255,.04);border:1px solid rgba(0,207,255,.08);
  border-radius:2px;padding:6px;text-align:center;}
.wi .wv{font-family:'Orbitron',sans-serif;font-size:.68rem;color:var(--arc);}
.wi .wl{font-size:.42rem;color:var(--text2);margin-top:2px;letter-spacing:.1em;}
.notif{font-size:.58rem;padding:6px 10px;background:rgba(0,207,255,.05);
  border:1px solid rgba(0,207,255,.1);border-left:3px solid var(--arc);
  border-radius:2px;margin-bottom:6px;color:var(--text2);line-height:1.6;animation:mi .25s ease;}
.notif.alert{border-left-color:var(--red);background:rgba(255,52,52,.05);}
.notif.success{border-left-color:var(--green);}

/* ══════════════ BOTTOM (mobile) ══════════════ */
.col-btm{grid-area:btm;display:grid;grid-template-columns:1fr;gap:12px;}
@media(min-width:500px){.col-btm{grid-template-columns:1fr 1fr;}}
@media(min-width:768px){.col-btm{display:none;}}

/* ══════════════ SETTINGS ══════════════ */
#settings-ov{display:none;position:fixed;inset:0;z-index:800;
  background:rgba(0,5,15,.95);backdrop-filter:blur(18px);padding:22px;overflow-y:auto;}
#settings-ov.show{display:block;}
.sv-wrap{max-width:560px;margin:0 auto;}
.st{font-family:'Orbitron',sans-serif;font-size:.95rem;letter-spacing:.3em;color:var(--arc);
  margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;}
.srow{display:flex;align-items:center;justify-content:space-between;
  padding:11px 0;border-bottom:1px solid rgba(0,207,255,.07);gap:10px;flex-wrap:wrap;}
.sl{font-size:.58rem;letter-spacing:.1em;color:var(--text2);}
.sinp{background:rgba(0,207,255,.06);border:1px solid var(--border);color:var(--text);
