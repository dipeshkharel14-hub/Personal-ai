  rl:localStorage.getItem('j_rl')||'en-US',
};
let rec=null,wakeRec=null,isListen=false,isWake=false,continuousDuplexActive=false;
let history=[],startT=Date.now(),reqN=0,vizBars=[],vizOn=false,vizRaf=null,camStream=null;
let hands=null, cameraUtilsInstance=null, ambientTimer=null;

/* ── STARTUP ── */
window.addEventListener('load',()=>{
