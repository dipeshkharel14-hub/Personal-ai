/* ── CONTINUOUS DUPLEX LISTENING (GEMINI-STYLE INTERRUPTIBLE STREAM) ── */
function startContinuousDuplexListening(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){console.warn("SpeechRecognition not supported");return;}
  try{
    if(rec) { try{rec.stop();}catch(e){} }
    rec=new SR();
    rec.continuous=true;
    rec.interimResults=true;
    rec.lang=cfg.rl;
    rec.maxAlternatives=3;

    rec.onresult=e=>{
      for(let i=e.resultIndex; i<e.results.length; i++){
        const transcript = e.results[i][0].transcript.trim();
        if(e.results[i].isFinal && transcript.length > 1){
          // USER STARTED SPEAKING WHILE JARVIS WAS SPEAKING -> IMMEDIATE INTERRUPTION!
          stopSpeech(); // Instantly cut off speech output
          document.getElementById('inp').value = transcript;
          processCmd(transcript);
        }
      }
    };

    rec.onerror=e=>{
      if(e.error!=='no-speech'&&e.error!=='aborted')console.log('DuplexErr:',e.error);
    };

    rec.onend=()=>{
      if(continuousDuplexActive) {
        setTimeout(()=>{ try{rec.start();}catch(e){} }, 300);
      }
    };

    rec.start();
    continuousDuplexActive=true;
    document.getElementById('msd').className='sd g';
    document.getElementById('mst').textContent='LIVE DUPLEX';
    document.getElementById('sr-v').textContent='LIVE';
  }catch(e){console.log('Duplex start err:',e);}
}

function toggleContinuousMic(){
  if(continuousDuplexActive){
    continuousDuplexActive=false;
    try{rec.stop();}catch(e){}
    document.getElementById('mic-btn').classList.remove('listening');
    document.getElementById('mic-btn').textContent='🎙️ DUPLEX OFF';
    document.getElementById('msd').className='sd r';
    document.getElementById('mst').textContent='MUTED';
    toast('🎙️ Live Duplex muted.');
  } else {
    startContinuousDuplexListening();
    document.getElementById('mic-btn').classList.add('listening');
    document.getElementById('mic-btn').textContent='🎙️ LIVE DUPLEX';
    toast('🎙️ Live Duplex active. Talk anytime!');
  }
}

/* ── TTS WITH INSTANT INTERRUPTION ── */
function jarvisSpeak(text){
  if(!cfg.voice||!window.speechSynthesis)return;
  window.speechSynthesis.cancel();
  
  const u=new SpeechSynthesisUtterance(text.replace(/[*_#`]/g,'').slice(0,600));
  u.lang='en-US';u.rate=0.92;u.pitch=0.8;u.volume=1;
  const vs=window.speechSynthesis.getVoices();
  const pref=vs.find(v=>v.name.includes('Google')&&v.lang.startsWith('en'))||vs.find(v=>v.name.includes('Daniel'))||vs.find(v=>v.lang.startsWith('en'));
  if(pref)u.voice=pref;
  
  u.onstart=()=>{
    setHero('SPEAKING','Listening for your voice...');
    startViz();
    document.getElementById('sr-v').textContent='🔊';
  };
  u.onend=()=>{
    stopViz();
    document.getElementById('sr-v').textContent='LIVE';
  };
  window.speechSynthesis.speak(u);
}

function stopSpeech(){
  if(window.speechSynthesis)window.speechSynthesis.cancel();
  stopViz();
  toast('🔇 Speech interrupted.');
}

if(window.speechSynthesis)window.speechSynthesis.onvoiceschanged=()=>window.speechSynthesis.getVoices();

/* ── AUDIO BEEP ── */
let actx=null;
function getACTX(){if(!actx)actx=new(window.AudioContext||window.webkitAudioContext)();return actx;}
function playBeep(type){
  try{
    const ctx=getACTX(),osc=ctx.createOscillator(),g=ctx.createGain();
    osc.connect(g);g.connect(ctx.destination);
    if(type==='wake'){osc.frequency.setValueAtTime(880,ctx.currentTime);osc.frequency.linearRampToValueAtTime(1200,ctx.currentTime+.15);g.gain.setValueAtTime(.12,ctx.currentTime);g.gain.linearRampToValueAtTime(0,ctx.currentTime+.25);osc.start();osc.stop(ctx.currentTime+.25);}
    else if(type==='listen'){osc.frequency.setValueAtTime(660,ctx.currentTime);g.gain.setValueAtTime(.08,ctx.currentTime);g.gain.linearRampToValueAtTime(0,ctx.currentTime+.15);osc.start();osc.stop(ctx.currentTime+.15);}
    else if(type==='resp'){osc.frequency.setValueAtTime(440,ctx.currentTime);osc.frequency.linearRampToValueAtTime(550,ctx.currentTime+.12);g.gain.setValueAtTime(.08,ctx.currentTime);g.gain.linearRampToValueAtTime(0,ctx.currentTime+.2);osc.start();osc.stop(ctx.currentTime+.2);}
  }catch(e){}
}

/* ── COMMAND PROCESSOR & ACTION ROUTER ── */
async function processCmd(raw){
  if(!raw.trim())return;
  stopSpeech();

  const text=raw.replace(/^(jarvis[\s,!]*)/i,'').trim()||raw.trim();
  addMsg('u',raw);document.getElementById('inp').value='';addLog(text.slice(0,32));
  reqN++;document.getElementById('sr-rq').textContent=reqN;
  const t=text.toLowerCase();

  if(/\b(visualization|visualize|open visualization|visualization portion)\b/.test(t)){
    startVisualizationMode();
    return;
  }

  if(/\b(scan|what i show|what am i looking at|analyze screen|scan screen|scan face)\b/.test(t)){
    scanCurrentScreen();
    return;
  }

  if(/\b(time|clock|what time|current time)\b/.test(t)){
    const n=new Date();
    const r=`The current time is ${n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true})}. Today is ${n.toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}. You are in ${LOC}, Sir.`;
    addMsg('j',r);jarvisSpeak(r);setHero('TIME',n.toLocaleTimeString());return;
  }

  const appMap={youtube:'https://m.youtube.com',maps:'https://maps.google.com',whatsapp:'https://web.whatsapp.com',gmail:'https://mail.google.com',instagram:'https://www.instagram.com',facebook:'https://m.facebook.com',spotify:'https://open.spotify.com',github:'https://github.com',twitter:'https://twitter.com',tiktok:'https://tiktok.com'};
  for(const[app,url]of Object.entries(appMap)){
    if(t.includes(app)){
      const r=`Opening ${app} now, Sir.`;
      addMsg('j',r);jarvisSpeak(r);window.open(url,'_blank');return;
    }
  }

  const sm=text.match(/(?:search|google|find|look up)\s+(?:for\s+)?(.+)/i);
  if(sm){
    const q=sm[1];
    window.open(`https://www.google.com/search?q=${encodeURIComponent(q)}`,'_blank');
    const r=`Searching Google for "${q}", Sir.`;
    addMsg('j',r);jarvisSpeak(r);return;
  }

  if(/\b(stop|pause|quiet|silence|shut up|cancel)\b/.test(t)){
    stopSpeech();addMsg('j',`Understood, Sir. Standing by.`);return;
  }

  await jarvisBrain(text, { owner: OWNER, location: LOC, time: new Date().toString() }, [], history);
}

/* ── VISUALIZATION & HAND GESTURE TRACING MODE ── */
async function startVisualizationMode() {
  const videoElement = document.getElementById('cam-vid');
  const canvasElement = document.getElementById('hand-canvas');
  const canvasCtx = canvasElement.getContext('2d');

  document.getElementById('camst').textContent = 'LIVE DUPLEX VISION & HANDS';

  try {
    if (!hands) {
      hands = new Hands({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
      });
      hands.setOptions({
        maxNumHands: 2,
        modelComplexity: 1,
        minDetectionConfidence: 0.65,
        minTrackingConfidence: 0.65
      });

      hands.onResults((results) => {
        canvasElement.width = videoElement.videoWidth || 640;
        canvasElement.height = videoElement.videoHeight || 480;
        canvasCtx.save();
        canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

        if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
          document.getElementById('hand-status').textContent = `HANDS: ${results.multiHandLandmarks.length} · 21 JOINTS ACTIVE`;
          
          results.multiHandLandmarks.forEach((landmarks, index) => {
            const connections = [
              [0,1],[1,2],[2,3],[3,4], // Thumb
              [0,5],[5,6],[6,7],[7,8], // Index
              [5,9],[9,10],[10,11],[11,12], // Middle
              [9,13],[13,14],[14,15],[15,16], // Ring
              [13,17],[17,18],[18,19],[19,20], // Pinky
              [0,17] // Palm base
            ];

            canvasCtx.strokeStyle = index === 0 ? 'rgba(0, 207, 255, 0.85)' : 'rgba(255, 193, 64, 0.85)';
            canvasCtx.lineWidth = 2.5;

            connections.forEach(([i, j]) => {
              const p1 = landmarks[i];
              const p2 = landmarks[j];
              canvasCtx.beginPath();
              canvasCtx.moveTo(p1.x * canvasElement.width, p1.y * canvasElement.height);
              canvasCtx.lineTo(p2.x * canvasElement.width, p2.y * canvasElement.height);
              canvasCtx.stroke();
            });

            landmarks.forEach((lm, idx) => {
              const x = lm.x * canvasElement.width;
              const y = lm.y * canvasElement.height;
              
              canvasCtx.fillStyle = idx === 4 || idx === 8 ? '#ffc140' : '#00cfff';
              canvasCtx.beginPath();
              canvasCtx.arc(x, y, idx === 4 || idx === 8 ? 5 : 3, 0, 2 * Math.PI);
              canvasCtx.fill();

              if (idx === 8 || idx === 4) {
                canvasCtx.strokeStyle = 'rgba(0, 255, 136, 0.9)';
                canvasCtx.lineWidth = 1.5;
                canvasCtx.strokeRect(x - 14, y - 14, 28, 28);
                
                canvasCtx.beginPath();
                canvasCtx.moveTo(x - 18, y); canvasCtx.lineTo(x + 18, y);
                canvasCtx.moveTo(x, y - 18); canvasCtx.lineTo(x, y + 18);
                canvasCtx.stroke();

                canvasCtx.fillStyle = '#00ff88';
                canvasCtx.font = '9px "Share Tech Mono"';
                canvasCtx.fillText(`ART_BLOCK[${idx}]`, x + 18, y - 6);
              }
            });
          });
        } else {
          document.getElementById('hand-status').textContent = 'FACE & DUPLEX ENVIRONMENT MONITORING';
        }
        canvasCtx.restore();
      });
    }

    if (!cameraUtilsInstance) {
      cameraUtilsInstance = new Camera(videoElement, {
        onFrame: async () => {
          if (videoElement.readyState >= 2) {
            await hands.send({ image: videoElement });
          }
        },
        width: 640,
        height: 480
      });
      await cameraUtilsInstance.start();
    }
  } catch (err) {
    console.error("Camera/Hand tracking error:", err);
  }
}/* ── SCREEN / VISION SCANNER ── */
