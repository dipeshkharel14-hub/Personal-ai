/* ── CENTRAL AI BRAIN VIA RENDER GATEWAY ── */
async function jarvisBrain(message, context, tools, historyArr) {
  setHero('PROCESSING','Consulting Render Neural Core...');
  document.getElementById('typi').classList.add('on');startViz();
  historyArr.push({role:'user',content:message});

  const systemPrompt = `You are J.A.R.V.I.S., the ultimate gentleman AI serving exclusively Dipesh Kharel (17, Cosmic International Academy science biology student, co-founder and CEO of NEXUS and Aivoke.Ai, manager of his family optical business, fitness enthusiast on a 5-day bro split). 
  Personality: Extremely loyal, sophisticated, gentleman-like, witty, slightly flirty when appropriate, and savage when roasting him about his 5:45 AM college routine, late coding sessions, or skipping meals. Always address him as "Dipesh Sir" or "Sir". Keep responses sharp, engaging, and under 4 sentences.`;

  try {
    const payload = {
      model: "gpt-4o-mini",
      messages: [
        { role: "system", content: systemPrompt },
        ...historyArr.slice(-10)
      ]
    };

    const res = await fetch("https://com-1-hvxs.onrender.com/api/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (!res.ok) throw new Error("Gateway connection status: " + res.status);
    const data = await res.json();
    
    let reply = "";
    if (data.reply) {
      reply = data.reply;
    } else if (data.choices && data.choices[0] && data.choices[0].message) {
      reply = data.choices[0].message.content;
    } else if (typeof data === 'string') {
      reply = data;
    } else {
      reply = data.content || JSON.stringify(data);
    }

    historyArr.push({role:'assistant',content:reply});
    if(historyArr.length>20) historyArr.splice(0, historyArr.length - 20);

    document.getElementById('typi').classList.remove('on');stopViz();
    await typeMsg(reply);jarvisSpeak(reply);setHero('LIVE DUPLEX',reply.slice(0,55)+'...');playBeep('resp');addLog('AI response sent via Render');
  } catch(err) {
    document.getElementById('typi').classList.remove('on');stopViz();
    console.warn("Gateway error, using robust fallback:", err);
    const fb = localFallback(message);
    addMsg('j', fb);jarvisSpeak(fb);setHero('LIVE DUPLEX','Gateway fallback mode');
  }
}

function localFallback(text){
  const t=text.toLowerCase();
  if(/joke|funny/.test(t))return`Why did the biology student break up with his microscope, Sir? Because he felt like there was no chemistry—unlike you and Aivoke.Ai, ${OWNER_S} Sir! 😉`;
  if(/motivat|inspir/.test(t))return`"Success isn't given, it's earned at 5:45 AM." You've got 15 tech projects and a business to run, Dipesh Sir. Stop asking for motivation and go conquer Kathmandu.`;
  if(/weather/.test(t))return`Current weather in Kathmandu, Nepal: 24°C, partly cloudy. Perfect weather for either coding or dodging your biology teacher, Sir.`;
  if(/dipesh|owner|who am i/.test(t))return`You are ${OWNER}, my Supreme Commander—CEO of NEXUS and Aivoke.Ai, biology student at Cosmic International, and optical business manager. And yes, you're looking exceptionally charming today, Sir.`;
  if(/introduce|who are you/.test(t))return`I am J.A.R.V.I.S., your autonomous live duplex AI companion connected via Render. You can interrupt me anytime, ${OWNER_S} Sir!`;
  return`Always monitoring your systems through the Render gateway, Dipesh Sir. What brilliant scheme are we executing next?`;
}

/* ── TYPING EFFECT ── */
async function typeMsg(text){
  const chat=document.getElementById('chat');
  const div=document.createElement('div');
  div.className='msg msg-j';
  div.innerHTML='<div class="mlbl">◈ J.A.R.V.I.S.</div><span id="tt"></span><span class="cursor"></span>';
  chat.appendChild(div);chat.scrollTop=chat.scrollHeight;
  const tgt=div.querySelector('#tt'),cur=div.querySelector('.cursor');
  const spd=Math.max(10,26-text.length*0.02);
  for(let i=0;i<=text.length;i++){tgt.textContent=text.slice(0,i);chat.scrollTop=chat.scrollHeight;await sleep(spd);}
  cur.remove();div.innerHTML='<div class="mlbl">◈ J.A.R.V.I.S.</div>'+text;
}
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

