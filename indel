function initRadar(){
  const cv=document.getElementById('radar');if(!cv)return;
  const ctx=cv.getContext('2d'),cx=100,cy=100;
  let ang=0;
  const dots=Array.from({length:12},()=>({r:15+Math.random()*75,a:Math.random()*Math.PI*2,f:0}));
  function draw(){
    ctx.clearRect(0,0,200,200);
    [25,50,75,95].forEach(r=>{ctx.strokeStyle='rgba(0,207,255,.12)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.stroke();});
    ctx.strokeStyle='rgba(0,207,255,.08)';
    [[cx-100,cy,cx+100,cy],[cx,cy-100,cx,cy+100]].forEach(([x1,y1,x2,y2])=>{ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();});
    ctx.save();ctx.translate(cx,cy);ctx.rotate(ang);
    const sg=ctx.createLinearGradient(0,0,95,0);sg.addColorStop(0,'rgba(0,207,255,.5)');sg.addColorStop(1,'rgba(0,207,255,0)');
    ctx.beginPath();ctx.moveTo(0,0);ctx.arc(0,0,95,-0.3,0.3);ctx.closePath();ctx.fillStyle=sg;ctx.fill();ctx.restore();
    dots.forEach(d=>{const da=ang%(Math.PI*2),dd=Math.abs(da-d.a%(Math.PI*2));if(dd<0.15||Math.abs(dd-Math.PI*2)<0.15)d.f=1;if(d.f>0){ctx.beginPath();ctx.arc(cx+Math.cos(d.a)*d.r*.95,cy+Math.sin(d.a)*d.r*.95,3,0,Math.PI*2);ctx.fillStyle='rgba(0,207,255,'+d.f+')';ctx.fill();d.f-=0.007;}});
    ctx.beginPath();ctx.arc(cx,cy,4,0,Math.PI*2);ctx.fillStyle='var(--arc)';ctx.fill();
    ctx.font='7px "Share Tech Mono"';ctx.fillStyle='rgba(0,207,255,.4)';ctx.textAlign='center';ctx.fillText('DIPESH · NEPAL',cx,192);
    ang+=0.022;requestAnimationFrame(draw);
  }
  draw();
