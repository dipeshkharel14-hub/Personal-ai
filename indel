  const steps=[
    {p:14,t:'INITIALIZING JARVIS...'},
    {p:28,t:'CONNECTING RENDER GATEWAY (https://com-1-hvxs.onrender.com)...'},
    {p:46,t:'ENGAGING LIVE DUPLEX INTERRUPTIBLE STREAM...'},
    {p:63,t:'AUTHENTICATING DIPESH KHAREL...'},
    {p:80,t:'ARMING SASS & FLIRT MATRIX...'},
