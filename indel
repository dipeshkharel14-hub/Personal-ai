  div.className='msg msg-j';
  div.innerHTML='<div class="mlbl">◈ J.A.R.V.I.S.</div><span id="tt"></span><span class="cursor"></span>';
  chat.appendChild(div);chat.scrollTop=chat.scrollHeight;
  const tgt=div.querySelector('#tt'),cur=div.querySelector('.cursor');
  const spd=Math.max(10,26-text.length*0.02);
  for(let i=0;i<=text.length;i++){tgt.textContent=text.slice(0,i);chat.scrollTop=chat.scrollHeight;await sleep(spd);}
  cur.remove();div.innerHTML='<div class="mlbl">◈ J.A.R.V.I.S.</div>'+text;
}
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

