function initHUD(){
  const cv=document.getElementById('hudc');if(!cv)return;
  const ctx=cv.getContext('2d');let t=0;
  function draw(){
    const W=cv.width,H=cv.height,cx=W/2,cy=H/2;
    ctx.clearRect(0,0,W,H);
    for(let i=0;i<12;i++){const a=(i/12)*Math.PI*2+t*.2,al=0.04+Math.sin(a*3+t)*.03;ctx.strokeStyle='rgba(0,207,255,'+al+')';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(cx,cy,105+i*2.5,a,a+0.18);ctx.stroke();}
    for(let i=0;i<4;i++){const a=(i/4)*Math.PI*2+t*.35*(i%2===0?1:-1);ctx.strokeStyle='rgba(255,52,52,'+(0.05+Math.sin(t*2+i)*.02)+')';ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,140+i*4,a,a+0.1);ctx.stroke();}
    for(let i=0;i<64;i++){const a=(i/64)*Math.PI*2,len=i%8===0?13:i%4===0?7:3,al=i%8===0?.3:.1;ctx.strokeStyle='rgba(0,207,255,'+al+')';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(cx+Math.cos(a)*155,cy+Math.sin(a)*155);ctx.lineTo(cx+Math.cos(a)*(155-len),cy+Math.sin(a)*(155-len));ctx.stroke();}
    ctx.strokeStyle='rgba(0,207,255,.1)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,155,0,Math.PI*2);ctx.stroke();
    t+=0.006;requestAnimationFrame(draw);
  }
  draw();
}

