  font-size:.66rem;outline:none;width:100%;max-width:270px;}
.sinp:focus{border-color:var(--arc);box-shadow:0 0 9px rgba(0,207,255,.15);}
.stog{display:flex;gap:5px;}
.stb{background:rgba(0,207,255,.05);border:1px solid rgba(0,207,255,.15);
  color:var(--text2);padding:5px 12px;cursor:pointer;border-radius:2px;
  font-size:.52rem;font-family:'Share Tech Mono',monospace;transition:all .2s;}
.stb.active{background:rgba(0,207,255,.18);color:var(--arc);border-color:var(--arc);}
.s-info{margin-top:14px;font-size:.58rem;color:var(--text2);line-height:1.9;
